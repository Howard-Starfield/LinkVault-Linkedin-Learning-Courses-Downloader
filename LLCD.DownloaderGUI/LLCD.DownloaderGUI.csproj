<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>LLCD.DownloaderGUI</RootNamespace>
    <AssemblyName>Linkedin-Learning-Courses-Downloader</AssemblyName>
    <ApplicationIcon>linked-learning-favicon.ico</ApplicationIcon>
    <Platforms>AnyCPU;x64</Platforms>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Nullable>disable</Nullable>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|x64'">
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|x64'">
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LLCD.CourseContent\LLCD.CourseContent.csproj" />
    <ProjectReference Include="..\LLCD.CourseExtractor\LLCD.CourseExtractor.csproj" />
    <ProjectReference Include="..\LLCD.DownloaderConfig\LLCD.DownloaderConfig.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Serilog" Version="4.3.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="fonts\Quicksand-Bold.ttf" CopyToOutputDirectory="PreserveNewest" />
    <None Update="fonts\Quicksand-Medium.ttf" CopyToOutputDirectory="PreserveNewest" />
    <None Update="fonts\Quicksand-Regular.ttf" CopyToOutputDirectory="PreserveNewest" />
    <None Update="fonts\Quicksand-SemiBold.ttf" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
