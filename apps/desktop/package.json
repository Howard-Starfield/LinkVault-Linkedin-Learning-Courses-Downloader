{
  "name": "linkvault-desktop",
  "private": true,
  "license": "MIT",
  "version": "0.2.20",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "build": "tsc && vite build",
    "build:editor-evaluation": "tsc && vite build --config vite.editor-evaluation.config.ts",
    "verify:clipping-note-editor-markdown": "node ./scripts/verify-clipping-note-editor-markdown.mjs",
    "verify:clipping-note-editor": "node ./scripts/verify-clipping-note-editor.mjs",
    "verify:clipping-note-autosave": "node --experimental-strip-types ./scripts/verify-clipping-note-autosave.mjs",
    "verify:clipping-note-lifecycle": "node --experimental-strip-types ./scripts/verify-clipping-note-lifecycle.mjs",
    "verify:clipping-note-durability-structure": "node ./scripts/verify-clipping-note-durability-structure.mjs",
    "verify:clipping-note-durability-browser": "node ./scripts/verify-clipping-note-durability-browser.mjs",
    "verify:newspaper-clipping-library-browser": "node ./scripts/verify-newspaper-clipping-library-browser.mjs",
    "verify:newspaper-clipping-library": "node ./scripts/verify-newspaper-clipping-library.mjs",
    "verify:newspaper-clipping-lifecycle": "node ./scripts/verify-newspaper-clipping-lifecycle.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 1420",
    "tauri": "tauri",
    "verify:architecture": "node ./scripts/verify-architecture.mjs",
    "verify:persistence": "node ./scripts/verify-persistence.mjs && cargo test --manifest-path ./src-tauri/Cargo.toml persistence_gate_ -- --test-threads=1",
    "verify:persistence-baseline": "node ./scripts/verify-persistence-baseline.mjs",
    "verify:ui": "node ./scripts/verify-ui.mjs",
    "verify:newspaper-performance": "node --experimental-strip-types ./scripts/verify-newspaper-performance.mjs",
    "verify:newspaper-performance-browser": "node ./scripts/verify-newspaper-performance-browser.mjs",
    "verify:newspaper-clippings": "node ./scripts/verify-newspaper-clippings.mjs",
    "verify:newspaper-clipping-reader": "node --experimental-strip-types ./scripts/verify-newspaper-clipping-reader.mjs",
    "verify:newspaper-clippings-browser": "node ./scripts/verify-newspaper-clippings-browser.mjs",
    "verify:visual": "node ./scripts/verify-visual.mjs",
    "verify:tauri-smoke": "node ./scripts/verify-tauri-smoke.mjs",
    "verify:release": "npm run verify:architecture && npm run verify:persistence && npm run verify:persistence-baseline && node ./scripts/verify-release.mjs",
    "verify:installer": "node ./scripts/verify-installer.mjs",
    "verify:release-manifest": "node ./scripts/verify-release-manifest.mjs",
    "verify:no-any": "node ./scripts/verify-no-any.mjs"
  },
  "dependencies": {
    "@tabler/icons-react": "^3.24.0",
    "@tanstack/react-virtual": "^3.14.8",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "2.7.1",
    "@tauri-apps/plugin-opener": "2.5.0",
    "@tiptap/core": "3.29.2",
    "@tiptap/extension-list": "3.29.2",
    "@tiptap/markdown": "3.29.2",
    "@tiptap/react": "3.29.2",
    "@tiptap/starter-kit": "3.29.2",
    "@tiptap/suggestion": "3.29.2",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^1.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.2",
    "playwright": "^1.60.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^8.0.16"
  }
}
