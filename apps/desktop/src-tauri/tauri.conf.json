{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LinkedVault",
  "version": "0.2.24",
  "identifier": "dev.linkvault.downloader",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LinkedVault",
        "width": 1280,
        "height": 800,
        "minWidth": 1280,
        "minHeight": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon-taskbar.png",
      "icons/icon-tray.png"
    ],
    "publisher": "LinkedVault",
    "shortDescription": "LinkedVault local archive workspace",
    "longDescription": "LinkedVault saves accessible courses and World Journal editions, then supports offline reading and durable clipping notes in a local archive workspace.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlENjAwNjZGRjdDOTc4RkUKUldUK2VNbjNid1pnblhpV203T0dackpCS0gvdzFQY1dTRkprWUJzdDJkTlNtVXAwbmRsKzlOVFYK",
      "endpoints": [
        "https://github.com/Howard-Starfield/LinkVault-Linkedin-Learning-Courses-Downloader/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
